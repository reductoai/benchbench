# Optional cache and run locations; paths may be absolute.
BENCHBENCH_CACHE=.cache/benchbench
BENCHBENCH_RUNS=results/runs
BENCHBENCH_RESULTS=results
# Provision a private S3-compatible bucket yourself and manage its lifecycle.
# With an AWS bucket, omit the endpoint override. Credentials need object read/write.
BENCHBENCH_S3_BUCKET=
BENCHBENCH_S3_ENDPOINT_URL=
BENCHBENCH_S3_REGION=us-east-1
BENCHBENCH_S3_ACCESS_KEY_ID=
BENCHBENCH_S3_SECRET_ACCESS_KEY=
# Optional env-file path loaded by `benchbench host` and real parse workers.
BENCHBENCH_HOST_ENV=
# Parser and judge credentials come from your own provider accounts.
REDUCTO_API_KEY=
LLAMA_CLOUD_API_KEY=
DATALAB_API_KEY=
EXTEND_API_KEY=
MISTRAL_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
PULSE_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
