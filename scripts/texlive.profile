selected_scheme scheme-basic
TEXDIR ${BENCHBENCH_RUNS}/native-tools/texlive/2025
TEXMFCONFIG ~/.texlive2025/texmf-config
TEXMFHOME ~/texmf
TEXMFLOCAL ${BENCHBENCH_RUNS}/native-tools/texlive/texmf-local
TEXMFSYSCONFIG ${BENCHBENCH_RUNS}/native-tools/texlive/2025/texmf-config
TEXMFSYSVAR ${BENCHBENCH_RUNS}/native-tools/texlive/2025/texmf-var
TEXMFVAR ~/.texlive2025/texmf-var
binary_x86_64-linux 1
instopt_adjustpath 0
instopt_letter 0
instopt_portable 0
tlpdbopt_autobackup 1
tlpdbopt_install_docfiles 0
tlpdbopt_install_srcfiles 0
